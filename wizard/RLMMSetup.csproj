<Project Sdk="Microsoft.NET.Sdk">

  <!-- RLMM-Setup.exe: a setup wizard around install.ps1. .NET Framework 4.8 ships with Windows 10 and 11, so the exe
       runs on any 64-bit Windows 10/11 machine with nothing else installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RLMM-Setup</AssemblyName>
    <RootNamespace>RLMMSetup</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>RLMM.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>RLMM Setup</Product>
    <AssemblyTitle>RLMM Setup - UDK for Rocket League map making</AssemblyTitle>
    <Description>Installs and updates UDK for Rocket League map making</Description>
    <Company>RLMM Setup</Company>
    <Copyright>RLMM Setup contributors</Copyright>
    <Version>1.0.1</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <!-- Test build (dotnet build -p:TestBuild=true): runs without administrator rights, for automated checks. -->
  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <ApplicationManifest>app.test.manifest</ApplicationManifest>
    <AssemblyName>RLMM-Setup-Test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\install.ps1" LogicalName="install.ps1" />
    <EmbeddedResource Include="..\assets\Misc.zip" LogicalName="Misc.zip" />
    <EmbeddedResource Include="RLMM.ico" LogicalName="RLMM.ico" />
    <EmbeddedResource Include="logo.png" LogicalName="logo.png" />
  </ItemGroup>

</Project>
